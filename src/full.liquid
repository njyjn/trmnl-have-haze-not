{%- comment -%}
  Full screen. Left column: halftone PSI map, its band legend, and the regional
  cities. Right column: the headline reading, pollutants, and the 24h forecast.
  Every variable used here is derived in shared.liquid, which TRMNL prepends
  to this file.

  Layout is framework classes throughout: a 12-column grid split 7/5 on the
  OG and 8/4 on the X (whose extra width goes to the map), and a single
  column in portrait. The OG rotated is only 480px wide and has no height
  to spare, so there the readings take two rows at a size down, the cities
  wrap to three across, and the per-region table stays X-only. The framework grid cannot reorder its cells, so the
  readings, which sit above the map in portrait, are captured once and
  emitted twice: beside the map, hidden in portrait, and above the grid,
  shown only in portrait.
{%- endcomment -%}

<div class="layout layout--col">

{%- comment -%} Captures render nothing; they sit inside .layout so it is the first element. {%- endcomment -%}
{%- capture fc_block -%}
  {%- if has_forecast -%}
    <span class="label label--small">PM2.5 next 24h &middot; {{ fc_trend }}</span>
    <svg class="aq-spark block" viewBox="0 0 {{ spark_w }} {{ spark_h }}" width="100%" preserveAspectRatio="none">
      {%- comment -%} NEA calls 1h PM2.5 above 55 elevated; show it when it is in range. {%- endcomment -%}
      {%- if fc_min < 55 and fc_max > 55 -%}
        {%- assign rule_y = 55 | minus: fc_min | times: spark_plot_h | times: 1.0 | divided_by: fc_span | plus: spark_pad -%}
        {%- assign rule_y = spark_h | minus: rule_y | round: 1 -%}
        <line class="aq-spark__rule" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" vector-effect="non-scaling-stroke" x1="0" y1="{{ rule_y }}" x2="{{ spark_w }}" y2="{{ rule_y }}"/>
      {%- endif -%}
      <polyline class="aq-spark__line" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" points="{{ spark_points }}"/>
    </svg>
    <div class="flex flex--between">
      <span class="label label--small label--gray-out 1bit:text--black">now {{ fc_now | round }}</span>
      <span class="label label--small label--gray-out 1bit:text--black">peak {{ fc_max | round }}</span>
      <span class="label label--small label--gray-out 1bit:text--black">{{ fc_times | last | date: '%-l%P' }} {{ fc_end | round }}</span>
    </div>
  {%- else -%}
    <span class="label label--small label--gray-out 1bit:text--black">Forecast unavailable</span>
  {%- endif -%}
{%- endcapture -%}

{%- capture headline_block -%}
  <div class="item">
    <div class="content">
      <span class="label label--small">{{ scale_name }} &middot; {{ home_label }}</span>
      <span class="value value--xxxlarge portrait:value--xxlarge lg:portrait:value--xxxlarge value--tnums">{{ home_value }}</span>
      <span class="title title--small">{{ home_band_label }}</span>
      <span class="description description--base">{{ home_band_advice }}</span>
    </div>
  </div>
{%- endcapture -%}

{%- capture pollutant_block -%}
  <div class="grid grid--cols-3 gap--small">
    <div class="item item--shrink">
      <div class="content">
        <span class="label label--small">Dominant</span>
        <span class="value value--small portrait:value--xsmall lg:portrait:value--small">{{ dom_name }}</span>
      </div>
    </div>
    <div class="item item--shrink">
      <div class="content">
        <span class="label label--small">PM2.5</span>
        <span class="value value--small portrait:value--xsmall lg:portrait:value--small value--tnums">{{ home_pm25 }}</span>
      </div>
    </div>
    <div class="item item--shrink">
      <div class="content">
        <span class="label label--small">PM10</span>
        <span class="value value--small portrait:value--xsmall lg:portrait:value--small value--tnums">{{ home_pm10 }}</span>
      </div>
    </div>
  </div>
  <span class="label label--small label--gray-out 1bit:text--black">24-hour average, &micro;g/m&sup3;</span>
{%- endcapture -%}

  {%- if has_psi == false -%}
    <div class="flex flex--col flex--center h--full">
      <span class="title title--large">No air quality data</span>
      <span class="description">data.gov.sg did not return a PSI reading</span>
    </div>
  {%- else -%}
    {%- comment -%} Portrait only: the readings as a row above the map. {%- endcomment -%}
    <div class="hidden portrait:block w--full">
      <div class="grid grid--cols-2 lg:grid--cols-3">
        <div class="col--span-2 lg:col--span-1">{{ headline_block }}</div>
        <div>{{ pollutant_block }}</div>
        <div>{{ fc_block }}</div>
      </div>
    </div>

    <div class="grid grid--cols-12 w--full">

      <div class="col--span-7 lg:col--span-8 portrait:col--span-12 lg:portrait:col--span-12 flex--col flex--stretch-x gap--small">
        {{ map_svg }}

        {%- comment -%}
          The legend is the only thing that makes dot size readable as a
          number, so it sits directly under the map at the same dot sizes.
          Columns are spaced by band count, not a fixed step, because US AQI
          has six bands to PSI's five. Dot above label above boundary, all
          centred: setting the label beside its dot collides with the next
          dot once six columns have to fit. The scale's name is in the
          headline, so the row only needs its numbers.
        {%- endcomment -%}
        {%- assign col_w = 430 | divided_by: band_count -%}
        {%- assign half_w = col_w | divided_by: 2 -%}
        <svg class="aq-legend block value--tnums" viewBox="0 0 430 40" width="100%" font-family="Inter Variable, Inter, sans-serif" fill="currentColor">
          {%- for lbl in band_short -%}
            {%- assign cx = forloop.index0 | times: col_w | plus: half_w -%}
            <circle cx="{{ cx }}" cy="8" r="{{ band_radii[forloop.index0] }}"/>
            <text x="{{ cx }}" y="24" text-anchor="middle" font-size="10" font-weight="500">{{ lbl }}</text>
            {%- if forloop.first -%}
              <text class="aq-legend__scale" x="{{ cx }}" y="37" text-anchor="middle" font-size="11" font-weight="700">0</text>
            {%- else -%}
              {%- assign prev = forloop.index0 | minus: 1 -%}
              {%- assign edge = band_edges[prev] | plus: 1 -%}
              <text class="aq-legend__scale" x="{{ cx }}" y="37" text-anchor="middle" font-size="11" font-weight="700">{{ edge }}{% if forloop.last %}+{% endif %}</text>
            {%- endif -%}
          {%- endfor -%}
        </svg>

        <div class="border--h-5"></div>

        {%- comment -%}
          The X has height the OG does not, so it gets the per-region
          readings the map can only show as a dot size.
        {%- endcomment -%}
        <div class="hidden lg:block">
          <div class="grid grid--cols-4">
            <span class="label label--small">Region</span>
            <span class="label label--small">{{ scale_short }}</span>
            <span class="label label--small">PM2.5</span>
            <span class="label label--small">PM10</span>
          </div>
          <div class="border--h-5"></div>
          {%- for layer in map_layers -%}
            {%- assign rname = layer | split: '|' | first -%}
            <div class="grid grid--cols-4">
              <span class="title title--small">{{ rname | capitalize }}</span>
              <span class="value value--xsmall value--tnums">{{ region_values[forloop.index0] }}</span>
              <span class="value value--xsmall value--tnums">{{ readings.pm25_twenty_four_hourly[rname] }}</span>
              <span class="value value--xsmall value--tnums">{{ readings.pm10_twenty_four_hourly[rname] }}</span>
            </div>
          {%- endfor -%}
        </div>

        <div>
          <span class="label label--small">Regional &middot; {{ scale_city_note }}</span>
          <div class="grid grid--cols-5 portrait:grid--cols-3 lg:portrait:grid--cols-5">
            {%- for city in om_cities -%}
              <div class="item item--shrink">
                <div class="content">
                  <span class="label label--small">{{ city_names[forloop.index0] }}</span>
                  <span class="value value--small value--tnums">{{ city_values[forloop.index0] }}</span>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>

      <div class="col--span-5 lg:col--span-4 portrait:hidden flex--col flex--stretch-x flex--center-y gap--small">
        {{ headline_block }}
        <div class="border--h-5"></div>
        <div>{{ pollutant_block }}</div>
        <div class="border--h-5"></div>
        <div>{{ fc_block }}</div>
      </div>

    </div>
  {%- endif -%}
</div>

{%- render 'title_bar', icon: title_icon, instance: nea_stamp -%}
