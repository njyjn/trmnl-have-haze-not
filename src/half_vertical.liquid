{%- comment -%}
  Left or right half of a side-by-side mashup: map on top, headline below.
  Wherever the half is taller than it is wide -- the X (520x780, 390x1040
  rotated) and the OG rotated (230x780) -- the regions and the forecast join
  in. The OG half in landscape (390x440) has no room for them.
{%- endcomment -%}

<div class="layout layout--col">
  {%- if has_psi == false -%}
    <div class="flex flex--col flex--center h--full">
      <span class="title title--small">No air quality data</span>
    </div>
  {%- else -%}
    <div class="flex flex--col gap--small w--full">
      <div class="w--full">{{ map_svg }}</div>
      <div class="border--h-5"></div>
      <div class="item">
        <div class="content">
          <span class="label label--small">{{ scale_name }} &middot; {{ home_label }}</span>
          <span class="value value--xxlarge value--tnums">{{ home_value }}</span>
          <span class="title title--small">{{ home_band_label }}</span>
          <span class="description">{{ dom_name }} leading &middot; PM2.5 {{ home_pm25 }}</span>
        </div>
      </div>

      <div class="hidden lg:block portrait:block w--full">
        <div class="border--h-5"></div>
        <div class="lg:portrait:hidden">
          <span class="label label--small">All regions</span>
          {%- comment -%} Five across does not fit the OG rotated (230px wide); three does. {%- endcomment -%}
          <div class="grid grid--cols-5 portrait:grid--cols-3">
            {%- for layer in map_layers -%}
              {%- assign rname = layer | split: '|' | first -%}
              <div class="item item--shrink">
                <div class="content">
                  <span class="label label--small">{{ rname | slice: 0, 1 | upcase }}</span>
                  <span class="value value--small value--tnums">{{ region_values[forloop.index0] }}</span>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%}
          The X rotated is 1040px tall: room for the full per-region table
          from the full view in place of the row above.
        {%- endcomment -%}
        <div class="hidden lg:portrait:block">
          <div class="grid grid--cols-4">
            <span class="label label--small">Region</span>
            <span class="label label--small">{{ scale_short }}</span>
            <span class="label label--small">PM2.5</span>
            <span class="label label--small">PM10</span>
          </div>
          {%- for layer in map_layers -%}
            {%- assign rname = layer | split: '|' | first -%}
            <div class="grid grid--cols-4">
              <span class="title title--small">{{ rname | capitalize }}</span>
              <span class="value value--xsmall value--tnums">{{ region_values[forloop.index0] }}</span>
              <span class="value value--xsmall value--tnums">{{ readings.pm25_twenty_four_hourly[rname] }}</span>
              <span class="value value--xsmall value--tnums">{{ readings.pm10_twenty_four_hourly[rname] }}</span>
            </div>
          {%- endfor -%}
        </div>

        <div class="border--h-5"></div>

        {%- if has_forecast -%}
          <span class="label label--small">PM2.5 next 24h &middot; {{ fc_trend }}</span>
          <svg class="aq-spark block" viewBox="0 0 {{ spark_w }} {{ spark_h }}" width="100%" preserveAspectRatio="none">
            <polyline class="aq-spark__line" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" points="{{ spark_points }}"/>
          </svg>
          <div class="flex flex--between">
            <span class="label label--small label--gray-out 1bit:text--black">now {{ fc_now | round }}</span>
            <span class="label label--small label--gray-out 1bit:text--black">peak {{ fc_max | round }}</span>
            <span class="label label--small label--gray-out 1bit:text--black">{{ fc_times | last | date: '%-l%P' }} {{ fc_end | round }}</span>
          </div>
        {%- else -%}
          <span class="label label--small label--gray-out 1bit:text--black">Forecast unavailable</span>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{%- render 'title_bar', icon: title_icon, instance: nea_hour -%}
