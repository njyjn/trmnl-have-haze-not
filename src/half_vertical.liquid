{%- comment -%}
  Left or right half of a side-by-side mashup: map on top, headline below.
  Wherever the half is taller than it is wide -- the X (520x780, 390x1040
  rotated) and the OG rotated (230x780) -- the regions and the forecast join
  in. The OG half in landscape (390x440) has no room for them.
{%- endcomment -%}

<div class="layout layout--col">
  {%- if has_psi == false -%}
    <div class="flex flex--col flex--center h--full">
      <span class="title title--small">No air quality data</span>
    </div>
  {%- else -%}
    <div class="flex flex--col gap--small w--full">
      <div class="w--full">{{ map_svg }}</div>
      <div class="border--h-5"></div>
      <div class="item">
        <div class="content">
          <span class="label label--small lg:label--base">{{ scale_name }} &middot; {{ home_label }}</span>
          <span class="value value--xxlarge lg:value--xxxlarge value--tnums">{{ home_value }}</span>
          <span class="title title--small lg:title--base">{{ home_band_label }}</span>
          <span class="description lg:description--large">{{ dom_name }} leading &middot; PM2.5 {{ home_pm25 }}</span>
        </div>
      </div>

      <div class="hidden lg:block portrait:block w--full">
        <div class="border--h-5"></div>
        <div class="lg:portrait:hidden">{{ region_row }}</div>

        {%- comment -%}
          The X rotated is 1040px tall: room for the full per-region table
          from the full view in place of the row above.
        {%- endcomment -%}
        <div class="hidden lg:portrait:block">
          <div class="grid grid--cols-4">
            <span class="label label--small lg:label--base">Region</span>
            <span class="label label--small lg:label--base">{{ scale_short }}</span>
            <span class="label label--small lg:label--base">PM2.5</span>
            <span class="label label--small lg:label--base">PM10</span>
          </div>
          {%- for layer in map_layers -%}
            {%- assign rname = layer | split: '|' | first -%}
            <div class="grid grid--cols-4">
              <span class="title title--small lg:title--base">{{ rname | capitalize }}</span>
              <span class="value value--xsmall lg:value--small value--tnums">{{ region_values[forloop.index0] }}</span>
              <span class="value value--xsmall lg:value--small value--tnums">{{ readings.pm25_twenty_four_hourly[rname] }}</span>
              <span class="value value--xsmall lg:value--small value--tnums">{{ readings.pm10_twenty_four_hourly[rname] }}</span>
            </div>
          {%- endfor -%}
        </div>

        <div class="border--h-5"></div>

        {{ fc_block_lg }}

        {%- comment -%} Still height to spare on the X rotated: the neighbouring capitals. {%- endcomment -%}
        <div class="hidden lg:portrait:block">
          <div class="border--h-5"></div>
          <span class="label label--small lg:label--base">Regional &middot; {{ scale_city_note }}</span>
          <div class="grid grid--cols-3">
            {%- for city in om_cities -%}
              <div class="item item--shrink">
                <div class="content">
                  <span class="label label--small lg:label--base">{{ city_names[forloop.index0] }}</span>
                  <span class="value value--small value--tnums">{{ city_values[forloop.index0] }}</span>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{%- render 'title_bar', icon: title_icon, instance: nea_hour -%}
