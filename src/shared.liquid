{%- comment -%} ---------- sources ---------- {%- endcomment -%}
{%- assign psi_item = IDX_0.data.items[0] -%}
{%- assign readings = psi_item.readings -%}
{%- assign psi_all = readings.psi_twenty_four_hourly -%}
{%- assign om = IDX_1.data -%}
{%- assign om_sg = om[0] -%}

{%- comment -%} ---------- home region ---------- {%- endcomment -%}
{%- comment -%}
  The custom field arrives as the option label ("West"), not the slug, so it
  has to be downcased before it will match NEA's keys. An unrecognised value
  must fall back rather than read as nil: every `nil <= n` comparison below is
  false, which would walk the band chain to its end and report Hazardous with
  a blank number -- the most alarming reading, from no data at all.
{%- endcomment -%}
{%- assign home_region = trmnl.plugin_settings.custom_fields_values.home_region | default: 'central' | downcase | strip -%}
{%- assign home_psi = psi_all[home_region] -%}
{%- unless home_psi -%}
  {%- assign home_region = 'central' -%}
  {%- assign home_psi = psi_all[home_region] -%}
{%- endunless -%}
{%- assign home_label = home_region | capitalize -%}

{%- comment -%} ---------- availability ---------- {%- endcomment -%}
{%- assign has_psi = false -%}
{%- if psi_item.timestamp and psi_all and home_psi -%}{%- assign has_psi = true -%}{%- endif -%}
{%- assign has_forecast = false -%}
{%- if om_sg.hourly.pm2_5 -%}{%- assign has_forecast = true -%}{%- endif -%}

{%- comment -%}
  NEA PSI bands. Band drives both the headline wording and the halftone dot
  radius on the map, so it is the one scale the whole screen agrees on.
{%- endcomment -%}
{%- assign home_band = 5 -%}
{%- assign home_band_label = 'Hazardous' -%}
{%- assign home_band_advice = 'Stay indoors' -%}
{%- if home_psi <= 50 -%}
  {%- assign home_band = 1 -%}{%- assign home_band_label = 'Good' -%}{%- assign home_band_advice = 'Normal activities' -%}
{%- elsif home_psi <= 100 -%}
  {%- assign home_band = 2 -%}{%- assign home_band_label = 'Moderate' -%}{%- assign home_band_advice = 'Normal activities' -%}
{%- elsif home_psi <= 200 -%}
  {%- assign home_band = 3 -%}{%- assign home_band_label = 'Unhealthy' -%}{%- assign home_band_advice = 'Reduce outdoor exertion' -%}
{%- elsif home_psi <= 300 -%}
  {%- assign home_band = 4 -%}{%- assign home_band_label = 'Very Unhealthy' -%}{%- assign home_band_advice = 'Avoid outdoor activity' -%}
{%- endif -%}

{%- comment -%}
  NEA publishes PSI as the highest pollutant sub-index, so the dominant
  pollutant is whichever sub-index is largest. NO2 is excluded from PSI and
  has no sub-index, which is why it is absent here.
{%- endcomment -%}
{%- assign dom_name = 'PM2.5' -%}
{%- assign dom_value = readings.pm25_sub_index[home_region] -%}
{%- assign cmp = readings.pm10_sub_index[home_region] -%}
{%- if cmp > dom_value -%}{%- assign dom_name = 'PM10' -%}{%- assign dom_value = cmp -%}{%- endif -%}
{%- assign cmp = readings.o3_sub_index[home_region] -%}
{%- if cmp > dom_value -%}{%- assign dom_name = 'Ozone' -%}{%- assign dom_value = cmp -%}{%- endif -%}
{%- assign cmp = readings.so2_sub_index[home_region] -%}
{%- if cmp > dom_value -%}{%- assign dom_name = 'SO2' -%}{%- assign dom_value = cmp -%}{%- endif -%}
{%- assign cmp = readings.co_sub_index[home_region] -%}
{%- if cmp > dom_value -%}{%- assign dom_name = 'CO' -%}{%- assign dom_value = cmp -%}{%- endif -%}

{%- assign home_pm25 = readings.pm25_twenty_four_hourly[home_region] -%}
{%- assign home_pm10 = readings.pm10_twenty_four_hourly[home_region] -%}

{%- comment -%} ---------- 24h PM2.5 forecast sparkline ---------- {%- endcomment -%}
{%- assign spark_w = 300 -%}
{%- assign spark_h = 52 -%}
{%- if has_forecast -%}
  {%- assign fc = om_sg.hourly.pm2_5 -%}
  {%- assign fc_times = om_sg.hourly.time -%}
  {%- assign fc_sorted = fc | sort -%}
  {%- assign fc_min = fc_sorted | first -%}
  {%- assign fc_max = fc_sorted | last -%}
  {%- assign fc_span = fc_max | minus: fc_min -%}
  {%- if fc_span <= 0 -%}{%- assign fc_span = 1 -%}{%- endif -%}
  {%- assign fc_now = fc | first -%}
  {%- assign fc_end = fc | last -%}
  {%- assign fc_last_i = fc.size | minus: 1 -%}
  {%- if fc_last_i < 1 -%}{%- assign fc_last_i = 1 -%}{%- endif -%}

  {%- assign spark_points = '' -%}
  {%- for v in fc -%}
    {%- assign sx = forloop.index0 | times: spark_w | times: 1.0 | divided_by: fc_last_i | round: 1 -%}
    {%- assign sy = v | minus: fc_min | times: spark_h | times: 1.0 | divided_by: fc_span -%}
    {%- assign sy = spark_h | minus: sy | round: 1 -%}
    {%- assign spark_points = spark_points | append: sx | append: ',' | append: sy | append: ' ' -%}
  {%- endfor -%}

  {%- assign fc_trend = 'steady' -%}
  {%- assign fc_delta = fc_end | minus: fc_now -%}
  {%- if fc_delta > 3 -%}{%- assign fc_trend = 'rising' -%}
  {%- elsif fc_delta < -3 -%}{%- assign fc_trend = 'falling' -%}{%- endif -%}
{%- endif -%}

{%- comment -%}
  Regional cities. Open-Meteo returns locations in request order and does not
  echo place names, so these labels must stay in step with the coordinate
  order in polling_url. See README "Changing the comparison cities".
{%- endcomment -%}
{%- assign city_names = 'Kuala Lumpur,Jakarta,Bangkok,Manila' | split: ',' -%}
{%- assign om_cities = om | slice: 1, 4 -%}

{%- comment -%}
  The map is captured once here rather than repeated in full.liquid and
  half_vertical.liquid. Liquid has no macros, and a capture is the only way to
  share markup between layouts. It renders at its natural 430px width; the
  layouts scale it with the wrapper's width.
{%- endcomment -%}
{%- capture map_svg -%}
  {%- if has_psi -%}
    <svg class="aq-map" viewBox="0 0 {{ map_w }} {{ map_h }}" width="100%">
      {%- for layer in map_layers -%}
        {%- assign parts = layer | split: '|' -%}
        {%- assign rname = parts[0] -%}
        {%- assign rpsi = psi_all[rname] -%}
        {%- comment -%} Same banding as the headline: dot size is the legend. {%- endcomment -%}
        {%- assign band = 5 -%}
        {%- if rpsi <= 50 -%}{%- assign band = 1 -%}
        {%- elsif rpsi <= 100 -%}{%- assign band = 2 -%}
        {%- elsif rpsi <= 200 -%}{%- assign band = 3 -%}
        {%- elsif rpsi <= 300 -%}{%- assign band = 4 -%}{%- endif -%}
        {%- assign dot_r = band | times: 7 | plus: 2 | divided_by: 10.0 -%}
        {%- assign dots = parts[1] | split: ' ' -%}
        <g>
          {%- for d in dots -%}
            {%- assign xy = d | split: ',' -%}
            <circle cx="{{ xy[0] }}" cy="{{ xy[1] }}" r="{{ dot_r }}"/>
          {%- endfor -%}
        </g>
      {%- endfor -%}

      <path d="{{ map_coast }}" fill="none" stroke="#000" stroke-width="1"/>

      {%- for lab in map_labels -%}
        {%- assign lparts = lab | split: '|' -%}
        {%- assign lname = lparts[0] -%}
        {%- assign lxy = lparts[1] | split: ',' -%}
        {%- assign lpsi = psi_all[lname] -%}
        {%- assign ly = lxy[1] | plus: 0 -%}
        {%- comment -%}
          A rounded box frames both label lines; a circle large enough to clear
          the region name would swamp its neighbours on the half layouts.
        {%- endcomment -%}
        {%- if lname == home_region -%}
          {%- assign box_x = lxy[0] | minus: 36 -%}
          {%- assign box_y = ly | minus: 17 -%}
          <rect x="{{ box_x }}" y="{{ box_y }}" width="72" height="38" rx="6" fill="#fff" stroke="#fff" stroke-width="5"/>
          <rect x="{{ box_x }}" y="{{ box_y }}" width="72" height="38" rx="6" fill="none" stroke="#000" stroke-width="2"/>
        {%- endif -%}
        {%- assign ly_name = ly | minus: 3 -%}
        {%- assign ly_psi = ly | plus: 15 -%}
        <text class="aq-map__halo" x="{{ lxy[0] }}" y="{{ ly_name }}" text-anchor="middle">{{ lname | upcase }}</text>
        <text class="aq-map__halo aq-map__psi" x="{{ lxy[0] }}" y="{{ ly_psi }}" text-anchor="middle">{{ lpsi }}</text>
      {%- endfor -%}
    </svg>
  {%- endif -%}
{%- endcapture -%}

<style>
  /* Without display:block + height:auto the SVG has no intrinsic height in a
     flex column and the whole layout collapses. */
  .aq-map, .aq-legend { display: block; width: 100%; height: auto; }
  .aq-map text { font-size: 11px; font-weight: 700; }
  .aq-map .aq-map__psi { font-size: 18px; }
  .aq-map .aq-map__halo { stroke: #fff; stroke-width: 3px; paint-order: stroke; }
  .aq-spark .aq-spark__line { fill: none; stroke: #000; stroke-width: 2px; }
  .aq-spark .aq-spark__rule { stroke: #000; stroke-width: 1px; stroke-dasharray: 3 3; }
  .aq-col--map { flex: 0 0 462px; width: 462px; }
  .aq-col--side { flex: 1 1 auto; min-width: 0; }
  .aq-legend { flex: 0 0 auto; }
  .aq-legend text { font-size: 10px; }
  .aq-legend .aq-legend__scale { font-size: 11px; font-weight: 700; }
</style>
